<view class="page">
  <view class="claim-context" wx:if="{{claimDeadlineText || claimStatusText}}">
    <view wx:if="{{claimDeadlineText}}" class="context-line">
      <text class="context-label">报损截止</text>
      <text>{{claimDeadlineText}}</text>
    </view>
    <view wx:if="{{claimStatusText}}" class="context-line">
      <text class="context-label">当前状态</text>
      <text>{{claimStatusText}}</text>
    </view>
  </view>
  <view class="card form">
    <view class="row">
      <text class="label">销售单号</text>
      <text class="value">{{saleNo || '-'}}</text>
    </view>
    <view class="field">
      <text class="label">损耗说明</text>
      <textarea maxlength="500" placeholder="请描述缺少或损坏的菜品与数量" bindinput="input" value="{{reason}}"></textarea>
    </view>
    <view class="field">
      <text class="label">图片凭证（最多 3 张）</text>
      <view class="img-grid">
        <view class="img-item" wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill"></image>
          <text class="remove" data-idx="{{index}}" bindtap="removeImage">×</text>
        </view>
        <view class="img-add" wx:if="{{images.length < 3}}" bindtap="chooseImages">＋</view>
      </view>
    </view>
    <view class="field">
      <text class="label">视频凭证（可选，最多 60 秒）</text>
      <view wx:if="{{videoUrl}}" class="video-row">
        <text>已上传视频</text>
        <text class="remove-link" bindtap="removeVideo">删除</text>
      </view>
      <button wx:else class="btn-ghost" size="mini" bindtap="chooseVideo">上传视频</button>
    </view>
    <button class="btn-primary submit" loading="{{submitting}}" disabled="{{!claimable}}" bindtap="submit">提交报备</button>
  </view>
</view>
